# === FUNCTION TO READ EACH FILE ===
def read_spectrum(filepath):
    filename = os.path.basename(filepath)

    # Look for time in filename: HH MM SS mmm
    # Accepts separators "-", "_", or ":"
    match = re.search(r"(\d{2})[-_:](\d{2})[-_:](\d{2})[-_:](\d{3})", filename)

    if not match:
        raise ValueError(f"No time found in filename: {filename}")

    hh, mm, ss, ms = map(int, match.groups())

    # Convert to total seconds (float)
    timestamp_seconds = hh*3600 + mm*60 + ss + ms/1000.0

    # Extract numeric data (first two columns)
    with open(filepath, 'r') as f:
        lines = f.readlines()

    data = []
    for line in lines:
        parts = line.strip().split()
        if len(parts) >= 2:
            try:
                x, y = float(parts[0]), float(parts[1])
                data.append((x, y))
            except ValueError:
                continue

    if not data:
        raise ValueError(f"No numeric data found in {filepath}")

    data = np.array(data)
    return data[:, 0], data[:, 1], timestamp_seconds


# === READ ALL FILES ===
spectra = []
for filename in sorted(os.listdir(folder)):
    if filename.lower().endswith(".txt"):
        filepath = os.path.join(folder, filename)
        try:
            x, y, time_str = read_spectrum(filepath)
            spectra.append((x, y, time_str))
            print(f"Loaded: {filename} ({time_str})")
        except Exception as e:
            print(f"Skipping {filename}: {e}")

if not spectra:
    raise RuntimeError("No valid spectra found.")

# === CONVERT TIMES TO SECONDS RELATIVE TO EARLIEST ===
def time_to_seconds(t_str):
    t = datetime.strptime(t_str, "%H:%M:%S")
    return t.hour * 3600 + t.minute * 60 + t.second

# === CONVERT TIMES TO RELATIVE SECONDS ===
times_raw = [t for _, _, t in spectra]
t0 = min(times_raw)
times_rel = np.array([t - t0 for t in times_raw])

# Sort spectra by time
sorted_idx = np.argsort(times_rel)
spectra = [spectra[i] for i in sorted_idx]
times_rel = times_rel[sorted_idx]


# === INTEGRATE EACH SPECTRUM BETWEEN 495–675 WITH BASELINE CORRECTION ===
integrations = []
for (x, y, _) in spectra:
    
    # --- BASELINE ESTIMATION (200–400 nm) ---
    baseline_mask = (x >= 650) & (x <= 850)
    if np.any(baseline_mask):
        baseline_region = y[baseline_mask]
        
        # Option 1 (recommended): Median (robust to outliers)
        baseline = np.median(baseline_region)

        # Option 2 (explicit outlier rejection):
        # mean = np.mean(baseline_region)
        # std = np.std(baseline_region)
        # filtered = baseline_region[(baseline_region > mean - 2*std) & (baseline_region < mean + 2*std)]
        # baseline = np.mean(filtered) if len(filtered) > 0 else mean

    else:
        baseline = 0  # fallback
    
    # Subtract baseline
    y_corrected = y - baseline
    
    # Perform integration using corrected spectrum
    mask = (x >= x_min) & (x <= x_max)
    area = np.trapezoid(y_corrected[mask], x[mask]) if np.any(mask) else 0
    integrations.append(area)

integrations = np.array(integrations)

